{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "decision",
    "reason"
  ],
  "additionalProperties": false,
  "properties": {
    "decision": {
      "enum": [
        "allow",
        "deny",
        "ask"
      ]
    },
    "reason": {
      "type": "string"
    }
  }
}
